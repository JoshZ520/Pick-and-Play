{{#if error}}
    <p class="error">{{error}}</p>
{{/if}}

<h1>Dashboard - Profile</h1>

{{!-- + 1 Button to vote test to a variable to change for let --}}
<p id="votes-display">Votes: 0 / 7</p>
<button id="add-btn" class="btn">Add 1</button>
<section class="admin-group-create">
    <h2>Create Group</h2>
    <form id="create-group-form">
        <label for="groupName">Group Name</label>
        <input id="groupName" name="groupName" type="text" required>

        <label for="winVote">Initial Winning Vote</label>
        <input id="winVote" name="winVote" type="text" placeholder="Optional">

        <button type="submit" class="pick-btn">Create Group</button>
    </form>
    <p id="create-group-feedback"></p>
</section>

<section class="my-groups">
    <h2>My Groups</h2>
    <p>These are the groups you have already joined.</p>
    {{#if myGroups.length}}
        <ul class="my-groups-list">
            {{#each myGroups}}
                <li class="my-group-item">{{groupName}}</li>
            {{/each}}
        </ul>
    {{else}}
        <p>You have not joined any groups yet.</p>
    {{/if}}
</section>

{{#if movies}}
    <div class="movies-grid">
        <h2>Movies</h2>
        <p>Browse movie options that can be picked for a group.</p>
        {{#each movies}}
            <div class="movie-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="movie-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Rating:</strong> {{rating}}</p>
                <p><strong>Runtime:</strong> {{runtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Movie</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No movies available yet. Check back soon!</p>
{{/if}}


{{#if games}}
    <div class="games">
        <h2>Games</h2>
        <p>Browse game options that can be picked for a group.</p>
        {{#each games}}
            <div class="game-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="game-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Min Players:</strong> {{minPlayers}}</p>
                <p><strong>Max Players:</strong> {{maxPlayers}}</p>
                <p><strong>Playtime:</strong> {{playtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Game</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No games available yet. Check back soon!</p>
{{/if}}

{{#if groups}}
    <div class="groups">
        <h2>Groups</h2>
        <p>Browse all available groups, see who is in them, and join one when you are ready.</p>
        {{#each groups}}
            <div class="group-card">
                {{#if groupName}}
                    <h3>{{groupName}}</h3>
                    <p>Winning Vote: {{votes}} / {{winVote}}</p>
                    <p><strong>Members:</strong>
                        {{#each memberDetails}}
                            {{#unless @first}}, {{/unless}}{{username}}{{#if isAdmin}} (Admin){{/if}}
                        {{else}}
                            None
                        {{/each}}
                    </p>
                    <button class="btn">Add Activity</button>
                    <button class="btn join-group-btn" data-id="{{_id}}">Join Group</button>
                {{/if}}
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No groups available yet. Check back soon!</p>
{{/if}}

<button id="logout-btn">Logout</button>

<script src="/js/dashboard.js"></script>