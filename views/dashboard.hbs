{{#if error}}
    <p class="error">{{error}}</p>
{{/if}}

<h1>Dashboard - Profile</h1>

{{#if isAdmin}}
    <section class="admin-group-create">
        <h2>Admin: Create Group</h2>
        <form id="create-group-form">
            <label for="groupName">Group Name</label>
            <input id="groupName" name="groupName" type="text" required>

            <label for="winVote">Initial Winning Vote</label>
            <input id="winVote" name="winVote" type="text" placeholder="Optional">

            <button type="submit" class="pick-btn">Create Group</button>
        </form>
        <p id="create-group-feedback"></p>
    </section>
{{/if}}

{{#if movies}}
    <div class="movies-grid">
        <h1>Movie Activities</h1>
        <p>See the latest groups and vote for your favorite activity!</p>
        {{#each movies}}
            <div class="movie-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="movie-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Rating:</strong> {{rating}}</p>
                <p><strong>Runtime:</strong> {{runtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Movie</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No movies available yet. Check back soon!</p>
{{/if}}


{{#if games}}
    <div class="games">
        <h1>Game Activities</h1>
        <p>See the latest groups and vote for your favorite activity!</p>
        {{#each games}}
            <div class="game-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="game-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Min Players:</strong> {{minPlayers}}</p>
                <p><strong>Max Players:</strong> {{maxPlayers}}</p>
                <p><strong>Playtime:</strong> {{playtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Game</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No games available yet. Check back soon!</p>
{{/if}}

{{#if groups}}
    <div class="groups">
        <h1>Group Activities</h1>
        <p>See the groups and their winning votes!</p>
        {{#each groups}}
            <div class="group-card">
                <h2>{{groupName}}</h2>
                <p><strong>Winning Vote:</strong> {{winVote}}</p>
                {{#if memberNames}}
                    <p><strong>Members ({{memberNames.length}}):</strong>
                        {{#each memberNames}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}
                    </p>
                {{else}}
                    <p><strong>Members:</strong> None</p>
                {{/if}}
                <button class="join-group-btn" data-id="{{_id}}">Join Group</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No groups available yet. Check back soon!</p>
{{/if}}

<button id="logout-btn">Logout</button>

<script src="/js/dashboard.js"></script>