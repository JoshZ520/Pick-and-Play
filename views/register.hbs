{{#if error}}
    <div class="flash-error"><p class="error">{{error}}</p></div>
{{/if}}

<div class="register-section">
    <h2>Register</h2>

    <form id="registerForm" method="POST" action="/auth/register" novalidate>
        <div class="form-group">
            <label for="username">Username: </label>
            <input id="username" name="username" type="text" placeholder="Enter your username" required>
            <small class="validation-msg"></small>
        </div>

        <div class="form-group">
            <label for="email">Email: </label>
            <input id="email" name="email" type="email" placeholder="Enter your email" required>
            <small class="validation-msg"></small>
        </div>

        <div class="form-group">
            <label for="password">Password: </label>
            <input id="password" name="password" type="password" placeholder="Enter your password" required>
            <small class="validation-msg"></small>
        </div>

        <div class="form-group">
            <label for="confirm-password">Confirm Password: </label>
            <input id="confirm-password" name="confirmPassword" type="password" placeholder="Confirm your password" required>
            <small class="validation-msg"></small>
        </div>

        <ul class="password-requirements">
            <li id="req-length" class="invalid">At least 12 characters</li>
            <li id="req-number" class="invalid">Contains a number</li>
            <li id="req-special" class="invalid">Contains a special character (!@#$%^&*)</li>
            <li id="req-match" class="invalid">Passwords must match</li>
        </ul>

        <div class="divider-placeholder"></div>
        <button class="register-btn" type="submit">Register</button>
    </form>

    <p>Already have an account? <a href="/login">Log in here</a></p>
    <p>Or register with:</p>
    <a href="/auth/google" class="btn red darken-1">
        <i class="fab fa-google left"></i> Log In With Google
    </a>
</div>
<script src="/js/register.js"></script>