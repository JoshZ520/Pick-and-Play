{{!-- <h1><i class="fas fa-book-reader"></i>Pick & Play</h1> --}}
{{#if error}}
    <div class="flash-error"><p class="error">{{error}}</p></div>
{{/if}}

<div class="login-section">
    <h2>Login</h2>

    <form id="loginForm" method="POST" action="/auth/login" novalidate>
        <div class="form-group">
            <label for="email">Email: </label>
            <input id="email" name="email" type="email" placeholder="Enter your email" required>
            <small class="validation-msg"></small>
        </div>

        <div class="form-group">
            <label for="password">Password: </label>
            <input id="password" name="password" type="password" placeholder="Enter your password" required>
            <small class="validation-msg"></small>
        </div>

        <button class="login-btn" type="submit">Login</button>
    </form>

    <p>Don't have an account? <a href="/register">Register here</a></p>
    <p>Or log in with:</p>
    <a class="btn red darken-1" href="/auth/google">
        <i class="fab fa-google left"></i> Log In With Google
    </a>
</div>
<script src="/js/login.js"></script>