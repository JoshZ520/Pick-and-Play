<div id="createGroupModal" class="modal-overlay is-hidden">
    <div class="modal-window">
        <span class="modal-close" id="closeCreateGroupModal">×</span>
        <h2>Create New Group</h2>
        <form id="createGroupForm">
            <div class="form-group">
                <label for="groupName">Group Name:</label>
                <input type="text" id="groupName" name="groupName" class="modal-input" required>
            </div>

            <div class="form-group">
                <p><strong>Optional Starting Activities</strong></p>
                <div class="activity-option-section">
                    <p>Movies</p>
                    <div class="activity-option-list">
                        {{#each movies}}
                            <label class="activity-option">
                                <input type="checkbox" class="create-group-activity" data-activity-type="movie" value="{{_id}}">
                                <span>{{title}}</span>
                            </label>
                        {{else}}
                            <p>No movies available</p>
                        {{/each}}
                    </div>
                </div>

                <div class="activity-option-section">
                    <p>Games</p>
                    <div class="activity-option-list">
                        {{#each games}}
                            <label class="activity-option">
                                <input type="checkbox" class="create-group-activity" data-activity-type="game" value="{{_id}}">
                                <span>{{title}}</span>
                            </label>
                        {{else}}
                            <p>No games available</p>
                        {{/each}}
                    </div>
                </div>
            </div>

            <button type="submit" class="btn modal-btn-create">Create Group</button>
        </form>
        <p id="formError" class="form-error is-hidden"></p>
    </div>
</div>

<div id="deleteGroupModal" class="modal-overlay is-hidden">
    <div class="modal-window">
        <span class="modal-close" id="closeDeleteGroupModal">×</span>
        <h2>Delete Group</h2>
        <form id="deleteGroupForm">
            <div class="form-group">
                <label for="groupSelect">Select Group to Delete:</label>
                <select id="groupSelect" name="groupId" class="browser-default modal-select" required>
                    {{#each groups}}
                        <option value="{{_id}}">{{#if groupName}}{{groupName}}{{else}}Unnamed Group{{/if}}</option>
                    {{else}}
                        <option value="">No groups available</option>
                    {{/each}}
                </select>
            </div>
            <button type="submit" class="btn modal-btn-delete">Delete Group</button>
        </form>
        <p id="deleteFormError" class="form-error is-hidden"></p>
    </div>
</div>

<div id="addActivityModal" class="modal-overlay is-hidden">
    <div class="modal-window">
        <span class="modal-close" id="closeAddActivityModal">×</span>
        <h2>Add Activity To Group</h2>
        <form id="addActivityForm">
            <input type="hidden" id="activityGroupId" name="groupId">

            <div class="form-group">
                <label for="activityGroupName">Group:</label>
                <input type="text" id="activityGroupName" class="modal-input" readonly>
            </div>

            <div class="form-group">
                <label for="activityType">Activity Type:</label>
                <select id="activityType" name="activityType" class="browser-default modal-select" required>
                    <option value="movie">Movie</option>
                    <option value="game">Game</option>
                </select>
            </div>

            <div class="form-group" id="movieSelectWrapper">
                <label for="movieActivitySelect">Movie:</label>
                <select id="movieActivitySelect" class="browser-default modal-select">
                    {{#each movies}}
                        <option value="{{_id}}">{{title}}</option>
                    {{else}}
                        <option value="">No movies available</option>
                    {{/each}}
                </select>
            </div>

            <div class="form-group is-hidden" id="gameSelectWrapper">
                <label for="gameActivitySelect">Game:</label>
                <select id="gameActivitySelect" class="browser-default modal-select">
                    {{#each games}}
                        <option value="{{_id}}">{{title}}</option>
                    {{else}}
                        <option value="">No games available</option>
                    {{/each}}
                </select>
            </div>

            <button type="submit" class="btn modal-btn-create">Add Activity</button>
        </form>
        <p id="addActivityFormError" class="form-error is-hidden"></p>
    </div>
</div>