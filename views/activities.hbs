{{#if error}}
    <p class="error">{{error}}</p>
{{/if}}

<h1>Groups</h1>

{{!-- + 1 Button to vote test to a variable to change for let --}}  
<p id="votes-display">Votes: 0 / 7</p>
<button id="add-btn" class="btn">Add 1</button>

<div class="group-actions">
    <button class="btn" id="createGroupBtn" type="button">Create a Group</button>
    <button class="btn" id="deleteGroupBtn" type="button" {{#unless groups}}disabled{{/unless}}>Delete a Group</button>
</div>

<div id="createGroupModal" class="modal-overlay is-hidden">
    <div class="modal-window">
        <span class="modal-close" id="closeCreateGroupModal">×</span>
        <h2>Create New Group</h2>
        <form id="createGroupForm">
            <div class="form-group">
                <label for="groupName">Group Name:</label>
                <input type="text" id="groupName" name="groupName" class="modal-input" required>
            </div>

            <button type="submit" class="btn modal-btn-create">Create Group</button>
        </form>
        <p id="formError" class="form-error is-hidden"></p>
    </div>
</div>

<div id="deleteGroupModal" class="modal-overlay is-hidden">
    <div class="modal-window">
        <span class="modal-close" id="closeDeleteGroupModal">×</span>
        <h2>Delete Group</h2>
        <form id="deleteGroupForm">
            <div class="form-group">
                <label for="groupSelect">Select Group to Delete:</label>
                <select id="groupSelect" name="groupId" class="browser-default modal-select" required>
                    {{#each groups}}
                        <option value="{{_id}}">{{#if groupName}}{{groupName}}{{else}}Unnamed Group{{/if}}</option>
                    {{else}}
                        <option value="">No groups available</option>
                    {{/each}}
                </select>
            </div>
            <button type="submit" class="btn modal-btn-delete">Delete Group</button>
        </form>
        <p id="deleteFormError" class="form-error is-hidden"></p>
    </div>
</div>

{{#if groups}}
    <div class="groups">
        <h2>Groups</h2>
        <p>See the available groups and their current vote totals.</p>
        {{#each groups}}
            {{#if this}}
            <div class="group-card">
                <h3>{{#if this.groupName}}{{this.groupName}}{{else}}Unnamed Group{{/if}}</h3>
                <p>Votes: {{this.votes}} / {{this.winVote}}</p>
                <button class="btn">Add Activity</button>
                {{!-- <button class="btn">Leave Group</button> --}}
            </div>
            {{/if}}
        {{/each}}
    </div>
{{else}}
    <p>No groups available yet. Create the first one to get started.</p>
{{/if}}

{{#if movies}}
    <div class="movies-grid">
        <h2>Movies</h2>
        <p>Browse movie options that can be picked for a group.</p>
        {{#each movies}}
            <div class="movie-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="movie-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Rating:</strong> {{rating}}</p>
                <p><strong>Runtime:</strong> {{runtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Movie</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No movies available yet. Check back soon!</p>
{{/if}}

{{#if games}}
    <div class="games">
        <h2>Games</h2>
        <p>Browse game options that can be picked for a group.</p>
        {{#each games}}
            <div class="game-card">
                {{#if imageURL}}
                    <img src="{{imageURL}}" alt="{{title}}" class="game-image">
                {{/if}}
                <h2>{{title}}</h2>
                <p><strong>Genre:</strong> {{genre}}</p>
                <p><strong>Min Players:</strong> {{minPlayers}}</p>
                <p><strong>Max Players:</strong> {{maxPlayers}}</p>
                <p><strong>Playtime:</strong> {{playtime}} minutes</p>
                <p>{{description}}</p>
                <button class="pick-btn" data-id="{{_id}}">Pick This Game</button>
            </div>
        {{/each}}
    </div>
{{else}}
    <p>No games available yet. Check back soon!</p>
{{/if}}

<script src="/js/activities.js"></script>

